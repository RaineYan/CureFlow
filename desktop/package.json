{
  "name": "cureflow-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "CureFlow Team",
  "description": "CureFlow trusted AI workflow desktop POC",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env CUREFLOW_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:web:backend": "python ../cureflow_app/server.py --port 8766 --data-dir ../.cureflow-desktop-data --allow-local-provider-setup",
    "dev:web:full": "concurrently -k -s first \"npm:dev:web\" \"npm:dev:web:backend\"",
    "dev:web:lan:full": "node scripts/start-lan.cjs",
    "build": "vite build",
    "test:ui-logic": "node --test scripts/ui-logic.test.mjs scripts/review-explanation.test.mjs",
    "start": "npm run build && electron .",
    "smoke-test": "node scripts/smoke-test.cjs",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "dist:win": "npm run build && npm run build:backend && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0",
    "wait-on": "9.1.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "cn.cureflow.desktop",
    "productName": "CureFlow",
    "artifactName": "CureFlow-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend-dist/cureflow-backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/cureflow-logo.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CureFlow",
      "deleteAppDataOnUninstall": false
    }
  }
}
